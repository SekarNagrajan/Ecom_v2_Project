<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.svm.ecom</groupId>
        <artifactId>ecomapi</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>rates-service</artifactId>
    <packaging>jar</packaging>
    <name>Rates Service</name>
    <description>Service for accessing rate and tariff data</description>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- Project-local CommonSurcharge jars (also packaged into ecomapi-service WAR) -->
        <surcharge.deps.dir>${project.basedir}/lib</surcharge.deps.dir>
    </properties>

    <dependencies>
        <!-- Spring Boot Starter Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Starter Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Boot Starter Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Boot Starter Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- SQL Server Driver -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI 3 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
        </dependency>

        <!-- Common Security Module -->
        <dependency>
            <groupId>com.svm.ecom</groupId>
            <artifactId>common-security</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- ECOM Common Module (enums, DTOs) -->
        <dependency>
            <groupId>com.svm.ecom</groupId>
            <artifactId>ecom-common</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!--
          CommonSurcharge engine (Booking Auto Rate).
          system scope is NOT transitive to the WAR — api-gateway copies these
          jars into WEB-INF/lib via maven-war-plugin webResources.
        -->
        <dependency>
            <groupId>com.svm.lrp.pnc.common</groupId>
            <artifactId>comsurcharge</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${surcharge.deps.dir}/comsurcharge.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.svm.lrp.pnc.common</groupId>
            <artifactId>commonsurcharge-bean</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${surcharge.deps.dir}/CommonSurchargeBean.jar</systemPath>
        </dependency>

        <!-- EJB API (CommonSurchargeLocal / CommonSurchargeBean SessionBean) -->
        <dependency>
            <groupId>javax.ejb</groupId>
            <artifactId>javax.ejb-api</artifactId>
            <version>3.2</version>
        </dependency>

        <!--
          JEP + DJep (XJep) — required by CommonSurcharge formula evaluation.
          Provides org.nfunk.jep.ParseException and org.lsmp.djep.xjep.XJep.
          system scope (same pattern as CommonSurcharge jars) — also copied into WAR.
        -->
        <dependency>
            <groupId>org.scijava</groupId>
            <artifactId>jep</artifactId>
            <version>2.4.2</version>
            <scope>system</scope>
            <systemPath>${surcharge.deps.dir}/jep-2.4.2.jar</systemPath>
        </dependency>

        <!-- Spring Boot Starter Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <finalName>rates-service</finalName>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
