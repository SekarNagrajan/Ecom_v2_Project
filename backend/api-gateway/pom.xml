<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>
<parent>
<groupId>com.svm.ecom</groupId>
<artifactId>ecomapi</artifactId>
<version>1.0.0</version>
</parent>
<artifactId>ecomapi-gateway</artifactId>
<packaging>war</packaging>
<name>API Gateway Module</name>
<dependencies>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-web</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-actuator</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-data-jpa</artifactId>
</dependency>
<dependency>
<groupId>com.microsoft.sqlserver</groupId>
<artifactId>mssql-jdbc</artifactId>
<scope>runtime</scope>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>common-security</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>swagger-config</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>tracking-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>master-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>register-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>schedule-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>carrier-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>sibl-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>summary-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>booking-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>com.svm.ecom</groupId>
<artifactId>rates-service</artifactId>
<version>${project.version}</version>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-test</artifactId>
<scope>test</scope>
</dependency>
</dependencies>
<build>
<finalName>ecomapi-service</finalName>
<plugins>
<plugin>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-maven-plugin</artifactId>
<version>${spring.boot.version}</version>
</plugin>
<plugin>
<groupId>org.apache.maven.plugins</groupId>
<artifactId>maven-war-plugin</artifactId>
<version>3.3.2</version>
<configuration>
<failOnMissingWebXml>false</failOnMissingWebXml>
<!--
  rates-service uses system-scoped CommonSurcharge / JEP jars (not transitive).
  Copy them into WEB-INF/lib so Tomcat can load surchargeVO / CommonSurcharge.
-->
<webResources>
<resource>
<directory>${project.basedir}/../rates-service/lib</directory>
<targetPath>WEB-INF/lib</targetPath>
<includes>
<include>comsurcharge.jar</include>
<include>CommonSurchargeBean.jar</include>
<include>jep-2.4.2.jar</include>
</includes>
</resource>
</webResources>
</configuration>
</plugin>
</plugins>
</build>
</project>